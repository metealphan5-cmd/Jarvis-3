// SES METNİNİ TEMİZLE

function sesMetniniTemizle(metin) {

    return metin
        .replace(/\*/g, "")
        .replace(/_/g, "")
        .replace(/#/g, "")
        .replace(/`/g, "")
        .replace(/[\u{1F300}-\u{1FAFF}]/gu, "")
        .replace(/[\u{2600}-\u{27BF}]/gu, "")
        .replace(/[\u{FE00}-\u{FE0F}]/gu, "")
        .replace(/\s+/g, " ")
        .trim();
}


// ERKEK TÜRKÇE SESİNİ BUL

function erkekTurkceSesiBul() {

    const sesler =
        speechSynthesis.getVoices();

    if (!sesler.length) {
        return null;
    }

    // Önce Türkçe sesleri bul
    const turkceSesler =
        sesler.filter(function(ses) {

            return ses.lang &&
                   ses.lang.toLowerCase().startsWith("tr");
        });

    if (!turkceSesler.length) {
        return null;
    }

    // Erkek olduğu bilinen / erkek adı taşıyan sesleri önceliklendir
    const erkekSes =
        turkceSesler.find(function(ses) {

            const isim =
                ses.name.toLowerCase();

            return (
                isim.includes("male") ||
                isim.includes("erkek") ||
                isim.includes("murat") ||
                isim.includes("cem") ||
                isim.includes("ahmet") ||
                isim.includes("mehmet")
            );
        });

    if (erkekSes) {
        return erkekSes;
    }

    // Uygun erkek sesi bulunamazsa ilk Türkçe sesi kullan
    return turkceSesler[0];
}


// SESLENDİR

function seslendir(metin) {

    const temizMetin =
        sesMetniniTemizle(metin);

    speechSynthesis.cancel();

    const ses =
        new SpeechSynthesisUtterance(
            temizMetin
        );

    ses.lang = "tr-TR";
    ses.rate = 0.88;
    ses.pitch = 0.75;
    ses.volume = 1;

    const erkekSes =
        erkekTurkceSesiBul();

    if (erkekSes) {
        ses.voice = erkekSes;
    }

    speechSynthesis.speak(ses);
}


