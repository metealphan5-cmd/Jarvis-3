async function jarvisSpeak() {

    const result =
        document.getElementById("result");

    result.textContent =
        "JARVIS düşünüyor...";

    try {

        const cevap =
            await puter.ai.chat(
                "Merhaba JARVIS. Türkçe, doğal ve kısa bir şekilde selam ver. Kullanıcıya efendim diye hitap et.",
                {
                    model: "gpt-5.6-luna"
                }
            );

        let metin = "";

        if (cevap?.message?.content) {
            metin = cevap.message.content;
        } else {
            metin = String(cevap);
        }

        result.textContent =
            "JARVIS: " + metin;

        seslendir(metin);

    } catch (error) {

        console.error(error);

        result.textContent =
            "Hata oluştu: " + error;
    }
}


